# photon:5.0 for arm64, whose Photon 4.0 update repository is no longer published
ARG photon_image=photon:4.0
FROM ${photon_image}

RUN tdnf -y upgrade >> /dev/null \
    && tdnf install -y nginx shadow curl ca-certificates >> /dev/null \
    && tdnf clean all \
    && groupmod -g 10000 nginx && usermod -g 10000 -u 10000 -d /home/nginx -s /bin/bash nginx \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log
